[MASTER]
ignore=.venv,.git,__pycache__

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-function-docstring,
    too-many-arguments,
    too-many-positional-arguments,
    too-few-public-methods,
    cyclic-import,
    redefined-outer-name,
    duplicate-code

[DESIGN]
max-args=10
